# Copie/adapte em .env.local (ignorado pelo Git). Nao coloque a chave neste exemplo.
# Chave apenas para o teste Node; nao e incorporada ao aplicativo.
GEOAPIFY_API_KEY=
# Integracao direta no Expo Go para testes de desenvolvimento.
