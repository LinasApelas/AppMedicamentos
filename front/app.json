{
  "expo": {
    "name": "AppMedicamentos",
    "slug": "AppMedicamentos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/img/Logo-square.png",
    "scheme": "appmedicamentos",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./src/img/Logo-square.png",
        "backgroundImage": "./src/img/Logo-square.png",
        "monochromeImage": "./src/img/Logo-square.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./src/img/Logo-square.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/img/Logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-sqlite",
      ["expo-location", {
        "locationWhenInUsePermission": "O SyncMed usa sua localização para encontrar farmácias próximas quando você solicita uma busca.",
        "isIosBackgroundLocationEnabled": false,
        "isAndroidBackgroundLocationEnabled": false,
        "isAndroidForegroundServiceEnabled": false
      }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
